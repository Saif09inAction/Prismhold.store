# MongoDB Atlas (production) or local
# MONGO_URI is used by the backend on Render
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/prismhold?retryWrites=true&w=majority

# Optional alias (backend accepts either)
# MONGODB_URI=mongodb+srv://...

# Server port (Render sets PORT automatically)
PORT=3000

# JWT secret - required in production
JWT_SECRET=your-secret-key-change-in-production

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your-google-client-id

# Razorpay (backend uses both; frontend receives public key from API)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# CORS: comma-separated origins allowed to call the API
# Set on Render to your Vercel frontend URL
CORS_ORIGIN=https://YOUR_FRONTEND_DOMAIN.vercel.app
