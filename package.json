{
  "name": "prismhold-mongodb",
  "version": "1.0.0",
  "description": "Prism Hold e-commerce with MongoDB backend",
  "main": "backend/server.js",
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "create-admin": "node backend/create-admin.js",
    "create-admin-quick": "node backend/create-admin-quick.js",
    "update-admin": "node backend/update-admin.js",
    "build": "npm run build-css",
    "build-css": "npx tailwindcss -i ./frontend/src/input.css -o ./frontend/dist/tailwind.css --minify",
    "watch-css": "npx tailwindcss -i ./frontend/src/input.css -o ./frontend/dist/tailwind.css --watch",
    "postinstall": "npm run build-css",
    "vercel-build": "npm run build-css"
  },
  "keywords": [
    "ecommerce",
    "mongodb",
    "express",
    "razorpay"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "google-auth-library": "^9.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.1.0",
    "mongoose": "^8.0.3",
    "multer": "^1.4.5-lts.1",
    "razorpay": "^2.9.6"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.24",
    "nodemon": "^3.0.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.0"
  }
}
