# Copy to .env and set values. On Render, set these in the dashboard.

# MongoDB Atlas connection string (required)
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/prismhold?retryWrites=true&w=majority

# Render sets PORT automatically
PORT=3000

# Required for JWT auth
JWT_SECRET=your-secret-key-change-in-production

# Razorpay (backend only; frontend gets public key from API)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Comma-separated origins allowed to call the API (e.g. your Vercel URL)
CORS_ORIGIN=https://YOUR_FRONTEND_DOMAIN.vercel.app

# Optional: Google sign-in
GOOGLE_CLIENT_ID=
